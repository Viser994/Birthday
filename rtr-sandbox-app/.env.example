# Payments Canada Developer Portal app credentials
# IMPORTANT: Create an app with product exactly: rtr-sandbox-product
# (payments-rail-sandbox will authenticate but RTR endpoints return 401)
# https://developer.payments.ca/
CONSUMER_KEY=your_consumer_key_here
CONSUMER_SECRET=your_consumer_secret_here

# Optional overrides
PORT=3001
API_BASE_URL=https://api.payments.ca
RTR_BASE_PATH=/rtr-sandbox

# Set to true to force demo/mock responses even when credentials exist
FORCE_DEMO_MODE=false
